{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "annotation_integration_execution_request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application_version",
    "adapter_version",
    "request_id",
    "project_id",
    "dataset_id",
    "run_id",
    "stage_id",
    "ion_mode",
    "exposure_label",
    "scientific_profile",
    "scientific_core_version",
    "frozen_script",
    "registered_inputs",
    "annotation_column_mappings",
    "samples",
    "conditions",
    "replicates",
    "comparison",
    "output_working_directory",
    "expected_output_artifact_types",
    "configuration_snapshot",
    "regression_reference",
    "environment_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "application_version": {
      "type": "string"
    },
    "adapter_version": {
      "const": "script04-adapter-1.0.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^req-"
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj-"
    },
    "dataset_id": {
      "type": "string",
      "pattern": "^dset-"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-"
    },
    "stage_id": {
      "const": "integrate_mzmine_annotations"
    },
    "ion_mode": {
      "const": "NEG"
    },
    "exposure_label": {
      "const": "Single"
    },
    "scientific_profile": {
      "type": "object",
      "required": [
        "profile_id",
        "profile_version",
        "reference_status"
      ]
    },
    "scientific_core_version": {
      "const": "1.0.0"
    },
    "frozen_script": {
      "type": "object",
      "required": [
        "script_id",
        "repository_relative_path",
        "sha256"
      ]
    },
    "registered_inputs": {
      "type": "object",
      "required": [
        "replicate_summary_artifact",
        "annotation_artifact"
      ]
    },
    "annotation_column_mappings": {
      "type": "object"
    },
    "samples": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "conditions": {
      "type": "array",
      "minItems": 2
    },
    "replicates": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "comparison": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object"
        }
      ]
    },
    "output_working_directory": {
      "type": "string",
      "minLength": 1
    },
    "expected_output_artifact_types": {
      "type": "array",
      "minItems": 1
    },
    "configuration_snapshot": {
      "type": "object"
    },
    "regression_reference": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "classification"
      ]
    },
    "environment_requirements": {
      "type": "object",
      "required": [
        "r_executable",
        "required_packages",
        "prohibit_runtime_installation"
      ]
    },
    "comparisons": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "comparison_id",
          "reference_condition_id",
          "comparison_condition_id"
        ],
        "additionalProperties": true
      }
    },
    "execution_adapter": {
      "type": "string"
    },
    "analysis_type": {
      "type": "string"
    },
    "display_metadata": {
      "type": "object"
    },
    "column_mappings": {
      "type": "object"
    },
    "acquisition_metadata": {
      "type": "object"
    },
    "pixel_metadata": {
      "type": "object"
    },
    "approved_scientific_configuration": {
      "type": "object"
    },
    "retention_options": {
      "type": "object"
    }
  }
}
