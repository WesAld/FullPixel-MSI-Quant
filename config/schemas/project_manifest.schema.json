{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_manifest.schema.json",
  "title": "FullPixel MSI Quant project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","application_id","application_version","project_id","project_name","project_created_at","project_updated_at","project_status","repository_root_policy","project_data_root","analysis_root","scientific_profile_id","scientific_profile_version","scientific_core_version","registered_datasets","active_artifacts","project_preferences","provenance_references","compatibility"],
  "properties": {
    "schema_version":{"type":"string"},
    "application_id":{"const":"FullPixelMSIQuant"},
    "application_version":{"type":"string"},
    "project_id":{"type":"string","pattern":"^prj-[a-z0-9][a-z0-9-]{2,63}$"},
    "project_name":{"type":"string","minLength":1},
    "project_description":{"type":["string","null"]},
    "project_created_at":{"type":"string","format":"date-time"},
    "project_updated_at":{"type":"string","format":"date-time"},
    "project_status":{"enum":["active","archived","invalid"]},
    "repository_root_policy":{"type":"string","minLength":1},
    "project_data_root":{"$ref":"#/$defs/path"},
    "analysis_root":{"$ref":"#/$defs/path"},
    "scientific_profile_id":{"type":"string","minLength":1},
    "scientific_profile_version":{"type":"string","minLength":1},
    "scientific_core_version":{"type":"string","minLength":1},
    "registered_datasets":{"type":"array","items":{"type":"string","pattern":"^dset-"}},
    "active_artifacts":{"type":"array","items":{"type":"string","pattern":"^art-"}},
    "project_preferences":{"type":"object"},
    "provenance_references":{"type":"array","items":{"type":"string","pattern":"^prov-"}},
    "compatibility":{"type":"object","required":["minimum_application_version"],"properties":{"minimum_application_version":{"type":"string"}},"additionalProperties":true}
  },
  "$defs":{"path":{"type":"object","additionalProperties":false,"required":["path","path_type","portability"],"properties":{"path":{"type":"string","minLength":1},"path_type":{"enum":["repository_relative","project_relative","external_absolute"]},"portability":{"enum":["portable","machine_specific"]}}}}
}
