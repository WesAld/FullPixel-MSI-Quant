# Keep ordinary source files portable.
.gitattributes text eol=lf
.Rbuildignore text eol=lf
*.R text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cff text eol=lf
RELEASE_SHA256SUMS.txt text eol=lf

# Frozen scientific scripts are byte-registered. Never normalize line endings.
validated-source/*.R -text
